{
  "$schema": "https://unpkg.com/release-it@21/schema/release-it.json",
  "git": {
    "requireBranch": "master",
    "requireCleanWorkingDir": true,
    "requireUpstream": true,
    "commitMessage": "chore: release v${version}",
    "tagName": "v${version}",
    "tagAnnotation": "system-one ${version}",
    "push": true
  },
  "npm": { "publish": false },
  "github": { "release": false },
  "hooks": {
    "before:init": ["pnpm verify"],
    "after:bump": "node -e \"const f='packages/system1/package.json',p=require('./'+f);p.version='${version}';require('fs').writeFileSync(f,JSON.stringify(p,null,2)+'\\n')\" && git add packages/system1/package.json"
  },
  "plugins": {
    "@release-it/keep-a-changelog": {
      "filename": "CHANGELOG.md",
      "addUnreleased": true,
      "addVersionUrl": true,
      "head": "master"
    }
  }
}
