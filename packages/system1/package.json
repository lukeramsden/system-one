    "./adapter": { "types": "./dist/adapter.d.ts", "import": "./dist/adapter.js" },
    "./effect": { "types": "./dist/effect.d.ts", "import": "./dist/effect.js" },
    "./adapters/typesafe": { "types": "./dist/adapters/typesafe.d.ts", "import": "./dist/adapters/typesafe.js" },
    "./adapters/cloudflare": { "types": "./dist/adapters/cloudflare.d.ts", "import": "./dist/adapters/cloudflare.js" },
    "./adapters/laya": { "types": "./dist/adapters/laya.d.ts", "import": "./dist/adapters/laya.js" },
    "./package.json": "./package.json"
