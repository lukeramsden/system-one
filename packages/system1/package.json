{
  "name": "system1",
  "version": "0.1.0",
  "description": "Typed decisions across System-1 models, with Promise and Effect-native clients",
  "license": "MIT",
  "author": "Luke Ramsden",
  "type": "module",
  "sideEffects": false,
  "engines": { "node": ">=22.18.0" },
  "files": ["dist", "README.md", "LICENSE"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
